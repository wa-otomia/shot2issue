{
  "name": "shot2issue-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Monorepo: shot2issue Chrome extension (apps/extension) + shot2issue desktop Tauri app (apps/desktop), sharing packages/core.",
  "workspaces": [
    "packages/core",
    "apps/extension",
    "apps/desktop"
  ],
  "scripts": {
    "build:ext": "npm run build --workspace apps/extension",
    "typecheck:ext": "npm run typecheck --workspace apps/extension",
    "test:ext": "npm run test --workspace apps/extension",
    "test:unit:ext": "npm run test:unit --workspace apps/extension",
    "package:ext": "bash apps/extension/scripts/build.sh",
    "dev:desktop": "npm run dev --workspace apps/desktop",
    "build:desktop": "npm run build --workspace apps/desktop"
  }
}
